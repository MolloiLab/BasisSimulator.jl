# Julia
*.jl.cov
*.jl.*.cov
*.jl.mem
LocalPreferences.toml

# Pkg lockfiles: a package commits none, but the docs are applications whose exact locks are part
# of every notebook export's fingerprint (docs/extract_all.jl).
Manifest*.toml
!docs/Manifest.toml
!docs/build_env/Manifest.toml

# Docs build (docs/build.sh, docs/render_notebooks.sh). docs/notebooks-static/ IS tracked: the
# GPU-rendered notebook exports the site ships.
docs/dist/
docs/node_modules/
docs/package-lock.json
docs/render-logs/
docs/.CondaPkg/

# Local datasets for the notebooks (AGENTS.md, "The documentation site"); never tracked
docs/notebooks/data/

# Pluto / SpaceStation
*.pluto-cache.toml
**.sessions.toml

# Agent instructions live in AGENTS.md only
/CLAUDE.md
.claude/

# macOS
.DS_Store
__pycache__/
